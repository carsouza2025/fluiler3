{
  "name": "fluiler",
  "private": true,
  "version": "2.1.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/buildOffline.mjs",
    "start": "node scripts/start.mjs",
    "lint": "tsc --noEmit",
    "setup": "node --import tsx scripts/provisionTeacher.ts",
    "test:security": "node --import tsx --test tests/*.test.ts",
    "test:legacy": "node --import tsx scripts/runLegacyChecks.ts",
    "check": "npm run lint && npm test && npm run build",
    "diagnostico": "node --import tsx scripts/diagnostico.ts",
    "test:validacao": "node --test validacao/tests/registro.test.cjs",
    "test": "npm run test:security && npm run test:validacao"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "^11.0.1"
  }
}
